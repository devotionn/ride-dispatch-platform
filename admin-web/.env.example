# Leave empty when admin web and API share the same origin or use the Vite dev proxy.
VITE_API_BASE_URL=

# Public Passenger H5 origin used when copying driver-specific booking links.
# Leave empty when admin and Passenger H5 are served on the same origin.
VITE_PASSENGER_H5_BASE_URL=

# AMap Web key. The securityJsCode must NOT be committed to the frontend.
VITE_AMAP_KEY=
VITE_AMAP_SERVICE_HOST=https://your-domain.example.com/_AMapService
