# Copy to deploy/production/.env and fill in real values. Never commit .env.
# All values below are placeholders only.

# ── Domain / ports ────────────────────────────────────────────────────────────
# Public domain (used for TLS certificate issuance and documentation).
APP_DOMAIN=example.com
HTTP_PORT=80
HTTPS_PORT=443
# Admin Web is served on its own HTTPS port (same certificate, same domain).
# Restrict this port to admin IPs in the cloud security group.
ADMIN_HTTPS_PORT=8443
TZ=Asia/Shanghai

# ── Database (MySQL container + backend production profile) ───────────────────
DB_NAME=ride_dispatch
DB_USERNAME=ride_dispatch
DB_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_STRONG_ROOT_PASSWORD

# ── First-run admin bootstrap ──────────────────────────────────────────────────
# Only creates the account when admin_user is empty. Use a strong unique value
# (known defaults like admin123 are refused in the production profile); rotate
# right after first login, then clear both values from .env.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ── Image tags (optional; deploy.sh manages the rollback tag) ──────────────────
# BACKEND_IMAGE=ride-dispatch-backend:local
# NGINX_IMAGE=ride-dispatch-nginx:local
