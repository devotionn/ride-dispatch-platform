# Backend API base. Leave empty when H5 and API share the same origin or when using Vite dev proxy.
VITE_API_BASE_URL=

# AMap Web (JS API) key. This is the browser-side Web key, not the securityJsCode.
VITE_AMAP_KEY=

# Production recommendation: point this to the server/Nginx proxy that appends securityJsCode.
# The /_AMapService prefix is required by AMap JS API security proxy mode.
VITE_AMAP_SERVICE_HOST=https://your-domain.example.com/_AMapService
